# ===========================================================================
# Asterisk PBX Web Management — 設定サンプル
#
# このファイルを .env としてコピーし、値を書き換えて使います。
#   cp .env.example .env
#
# .env には管理パスワードなどが入るため、Git にコミットしないでください
# (.gitignore で除外済みです)。
# ===========================================================================

# ===== 管理画面のログイン (重要) =====
# 本ツールは PBX の全設定を変更でき、留守番電話の録音も再生できます。
# パスワードを設定しないと、この画面に到達できる人は誰でも
# 会社の電話を自由に操作できる状態になります。必ず設定してください。
#
# パスワードの生成例:
#   head -c 18 /dev/urandom | base64
ADMIN_USER=admin
ADMIN_PASSWORD=

# 平文を置きたくない場合は、代わりにハッシュを設定できます。
#   python -m app.auth hash
# ADMIN_PASSWORD_HASH=pbkdf2_sha256$240000$...

# ログインの有効時間 (秒)。既定は 12 時間。
SESSION_MAX_AGE=43200

# セッション Cookie の署名鍵。空にすると起動ごとにランダム生成されます
# (= サービス再起動でログアウトされる)。固定したい場合は 32 文字以上の
# ランダム文字列を設定してください。
#   head -c 32 /dev/urandom | base64
SECRET_KEY=

# ===== Web =====
# 待ち受けアドレス。
#   127.0.0.1 … このサーバー上からのみアクセス可 (既定・安全)
#   0.0.0.0   … LAN の他の PC からもアクセス可 (ADMIN_PASSWORD を必ず設定)
HOST=127.0.0.1
PORT=8080

# 例外時にスタックトレースをブラウザへ返すかどうか。
# 設定内容やパスが漏れるため、運用時は必ず false にしてください。
DEBUG=false

# ===== Database =====
# SQLite (小〜中規模ならこれで十分)
DATABASE_URL=sqlite+aiosqlite:///./pbx.db

# PostgreSQL を使う場合 (別途 `pip install -e ".[postgres]"` が必要)
# DATABASE_URL=postgresql+asyncpg://pbx:pbx@localhost:5432/pbx

# ===== Asterisk =====
# 設定ファイル出力先 (Asterisk が読むディレクトリ)
ASTERISK_CONFIG_DIR=/etc/asterisk

# 音源 (WAV) 配置先 (Asterisk が読むディレクトリ)
ASTERISK_SOUNDS_DIR=/var/lib/asterisk/sounds/ja/managed

# RTP ポート範囲
RTP_START=10000
RTP_END=20000

# AMI (Asterisk Manager Interface)
# AMI_SECRET は manager.conf に書き出されます。必ず変更してください。
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USER=admin
AMI_SECRET=
AMI_PERMIT=127.0.0.1/255.255.255.255

# 既定の SIP コンテキスト名
DEFAULT_CONTEXT=from-internal

# ===== 内部フック (Asterisk → 本ツール) =====
# Asterisk のダイヤルプランから本ツールへ通知を送る際の合言葉です。
# 空のままにしておくと、初回起動時にランダムな値が自動生成されて
# DB に保存されます (通常はそれで問題ありません)。
# 明示的に固定したい場合だけ設定してください。
# FAX_HOOK_TOKEN=
# VOICEMAIL_HOOK_TOKEN=
# CALLLOG_HOOK_TOKEN=

# 内部フックを受け付ける送信元 IP (カンマ区切り)。
# Asterisk と本ツールを同じサーバーで動かす場合は既定のままで OK。
# 別のサーバーにある場合は、その IP を追加してください。
# 空文字にすると送信元を制限しません (非推奨)。
TRUSTED_HOOK_HOSTS=127.0.0.1,::1

# ===== 音源変換 (ffmpeg) =====
FFMPEG_PATH=ffmpeg
UPLOADS_DIR=./uploads

# ===== 音声合成 (Open JTalk) =====
# 画面から追加する音響モデル (.htsvoice) の保存先。
# apt で入る標準の声は /usr/share/hts-voice にありますが root 所有で
# 書き込めないため、画面から追加する声はこちらへ保存します。
# 声の一覧表示では両方を探すので、apt で入れた声もそのまま使えます。
HTS_VOICE_DIR=/var/lib/asterisk-pbx-web/hts-voice

# ===== FAX 送受信 (Asterisk + spandsp) =====
# Asterisk が ReceiveFAX/SendFAX で読み書きする TIFF 置き場
# (asterisk ユーザーと本ツールの両方が読み書きできる必要あり)
FAX_SPOOL_DIR=/var/spool/asterisk/fax

# 送受信済み FAX を PDF で永続保存するディレクトリ
FAX_STORE_DIR=/var/lib/asterisk-pbx-web/fax

# 受信 TIFF→PDF 変換コマンド (libtiff-tools)
TIFF2PDF_PATH=tiff2pdf

# 送信 PDF→TIFF 変換コマンド (ghostscript)
GS_PATH=gs

# ===== ボイスメール =====
VOICEMAIL_SPOOL_DIR=/var/spool/asterisk/voicemail

# ===== バックアップ =====
BACKUP_DIR=./backups
